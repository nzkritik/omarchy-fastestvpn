#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# fvpn-wipe — remove every trace of this plugin's NetworkManager profiles
#
#   bash fvpn-wipe --dry-run    list what would go (the default)
#   bash fvpn-wipe --yes        do it
#
# UNPRIVILEGED, like the importer. Deleting a system connection is the same
# polkit action as creating one, and the certificates an unprivileged import
# extracts live in your own data directory, so nothing here needs root.
#
# Removes only what this plugin created:
#   * NetworkManager connections named fvpn-*
#   * $XDG_DATA_HOME/networkmanagement/certificates/nm-openvpn/fvpn-*.pem
#
# Versions of this plugin up to 0.2.0 imported as root, which staged profiles in
# /etc/openvpn and copied certificates into /etc/NetworkManager/certificates/fvpn.
# Those paths are root-owned, so this script REPORTS them and prints the command
# to remove them rather than asking for privilege it otherwise never wants.
#
# Never touches /etc/openvpn/{client,server} — those belong to the openvpn
# package — nor the keyring credential, nor the endpoint catalogue.
# ---------------------------------------------------------------------------
set -uo pipefail

CERT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/networkmanagement/certificates/nm-openvpn"
LEGACY_OVPN_DIR=/etc/openvpn
LEGACY_CERT_DIR=/etc/NetworkManager/certificates/fvpn

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

dry=1
for a in "$@"; do
    case "$a" in
        --dry-run) dry=1 ;;
        --yes)     dry=0 ;;
        *) echo "usage: $0 [--dry-run|--yes]" >&2; exit 2 ;;
    esac
done

(( EUID != 0 )) || die "do not run this as root; it is meant to run as your own user"
command -v nmcli >/dev/null || die "nmcli not found"

# ── Inventory ───────────────────────────────────────────────────────────────
mapfile -t conns < <(nmcli -t -f NAME connection show 2>/dev/null | grep '^fvpn-' || true)

# -maxdepth 1 -type f keeps this to plain files we wrote, and skips a symlink
# planted in a directory that is, like any path under $HOME, user-writable.
mapfile -t certs < <(
  find "$CERT_DIR" -maxdepth 1 -type f -name 'fvpn-*.pem' -print 2>/dev/null | sort
)

# Summarised, not enumerated: a full import leaves 134 staged profiles and
# printing them all buries everything else this script has to say.
legacy_ovpn=$(
  find "$LEGACY_OVPN_DIR" -maxdepth 1 -type f \
       \( -name '*-udp.ovpn' -o -name '*-tcp.ovpn' \) -print 2>/dev/null | wc -l
)
legacy=()
(( legacy_ovpn )) && legacy+=("$LEGACY_OVPN_DIR/*-{udp,tcp}.ovpn  ($legacy_ovpn files)")
for p in "$LEGACY_OVPN_DIR/udp_files" "$LEGACY_OVPN_DIR/tcp_files" \
         "$LEGACY_OVPN_DIR/fastestvpn_ovpn.zip" "$LEGACY_CERT_DIR"; do
    [[ -e "$p" ]] && legacy+=("$p")
done

printf 'NetworkManager connections : %d\n' "${#conns[@]}"
printf 'certificate files          : %d (%s)\n' "${#certs[@]}" "$CERT_DIR"
printf 'root-owned leftovers       : %d path(s)\n' "${#legacy[@]}"

if (( dry )); then
    echo
    echo "(dry run — nothing changed; pass --yes to remove)"
    if (( ${#legacy[@]} )); then
        echo
        echo "Root-owned leftovers from a pre-0.3.0 import, listed but never touched:"
        printf '  %s\n' "${legacy[@]}"
    fi
    exit 0
fi

# ── Remove ──────────────────────────────────────────────────────────────────
echo
# Take any active VPN down first, or NM keeps the device and the delete leaves
# a live tunnel behind with no connection to bring it back down.
while IFS=: read -r uuid type; do
    [[ "$type" == "vpn" ]] || continue
    nmcli connection down uuid "$uuid" >/dev/null 2>&1 || true
done < <(nmcli --terse --fields UUID,TYPE connection show --active 2>/dev/null)

deleted=0
for c in "${conns[@]}"; do
    # Duplicate ids can share a name, so delete until the name is gone rather
    # than once per listed row.
    while nmcli -t -f NAME connection show 2>/dev/null | grep -qx "$c"; do
        nmcli connection delete id "$c" >/dev/null 2>&1 || break
        deleted=$((deleted + 1))
    done
done
echo "removed $deleted NetworkManager connection(s)"

(( ${#certs[@]} )) && rm -f -- "${certs[@]}"
echo "removed ${#certs[@]} certificate file(s)"

nmcli connection reload 2>/dev/null || true

remaining=$(nmcli -t -f NAME connection show 2>/dev/null | grep -c '^fvpn-')
echo "remaining fvpn-* connections: $remaining"

if (( ${#legacy[@]} )); then
    echo
    echo "Left in place, because they are root-owned and this plugin does not"
    echo "ask for privilege. They are inert once the connections above are gone."
    printf '  %s\n' "${legacy[@]}"
    echo
    echo "They are root-owned, so removing them needs root rights — do that"
    echo "yourself, with the paths above, if you want them gone."
fi

[[ "$remaining" == "0" ]] || die "some connections survived — inspect manually"
