#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# fvpn-wipe — remove every trace of this plugin's NetworkManager profiles
#
#   sudo bash fvpn-wipe --dry-run    list what would go
#   sudo bash fvpn-wipe --yes        do it
#
# Deletes only what this plugin created:
#   * NetworkManager connections named fvpn-*
#   * top-level /etc/openvpn/<id>-{udp,tcp}.ovpn profiles it installed
#   * the legacy startVPN.sh bundle (udp_files/, tcp_files/, the zip)
#   * /etc/NetworkManager/certificates/fvpn/
#
# Never touches /etc/openvpn/{client,server} — those belong to the openvpn
# package — nor the keyring credential, nor the endpoint catalogue.
# ---------------------------------------------------------------------------
set -uo pipefail

OVPN_DIR=/etc/openvpn
CERT_DIR=/etc/NetworkManager/certificates/fvpn

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

dry=1
for a in "$@"; do
    case "$a" in
        --dry-run) dry=1 ;;
        --yes)     dry=0 ;;
        *) echo "usage: $0 [--dry-run|--yes]" >&2; exit 2 ;;
    esac
done

[[ $EUID -eq 0 ]] || die "must run as root"
command -v nmcli >/dev/null || die "nmcli not found"

# ── Inventory ───────────────────────────────────────────────────────────────
mapfile -t conns < <(nmcli -t -f NAME connection show 2>/dev/null | grep '^fvpn-' || true)

# Only the flat <id>-udp.ovpn / <id>-tcp.ovpn files the importer wrote. -maxdepth 1
# keeps this away from the package's client/ and server/ directories entirely.
mapfile -t profiles < <(
  find "$OVPN_DIR" -maxdepth 1 -type f \
       \( -name '*-udp.ovpn' -o -name '*-tcp.ovpn' \) -print 2>/dev/null | sort
)

legacy=()
for p in "$OVPN_DIR/udp_files" "$OVPN_DIR/tcp_files" "$OVPN_DIR/fastestvpn_ovpn.zip"; do
    [[ -e "$p" ]] && legacy+=("$p")
done

certs=0
[[ -d "$CERT_DIR" ]] && certs=$(find "$CERT_DIR" -type f 2>/dev/null | wc -l)

printf 'NetworkManager connections : %d\n' "${#conns[@]}"
printf 'profiles in %-14s: %d\n' "$OVPN_DIR" "${#profiles[@]}"
printf 'legacy bundle paths        : %d %s\n' "${#legacy[@]}" "${legacy[*]:-}"
printf 'certificate files          : %d (%s)\n' "$certs" "$CERT_DIR"

if (( dry )); then
    echo
    echo "(dry run — nothing changed; pass --yes to remove)"
    exit 0
fi

# ── Remove ──────────────────────────────────────────────────────────────────
echo
# Take any active VPN down first, or NM keeps the device and the delete leaves
# a live tunnel behind with no connection to bring it back down.
while IFS=: read -r uuid type; do
    [[ "$type" == "vpn" ]] || continue
    nmcli connection down uuid "$uuid" >/dev/null 2>&1 || true
done < <(nmcli --terse --fields UUID,TYPE connection show --active 2>/dev/null)

deleted=0
for c in "${conns[@]}"; do
    # Duplicate ids can share a name, so delete until the name is gone rather
    # than once per listed row.
    while nmcli -t -f NAME connection show 2>/dev/null | grep -qx "$c"; do
        nmcli connection delete id "$c" >/dev/null 2>&1 || break
        (( deleted++ ))
    done
done
echo "removed $deleted NetworkManager connection(s)"

(( ${#profiles[@]} )) && rm -f -- "${profiles[@]}"
echo "removed ${#profiles[@]} profile(s) from $OVPN_DIR"

(( ${#legacy[@]} )) && rm -rf -- "${legacy[@]}"
echo "removed ${#legacy[@]} legacy bundle path(s)"

if [[ -d "$CERT_DIR" ]]; then
    rm -rf -- "$CERT_DIR"
    echo "removed $CERT_DIR ($certs file(s))"
fi

nmcli connection reload 2>/dev/null || true

echo
remaining=$(nmcli -t -f NAME connection show 2>/dev/null | grep -c '^fvpn-')
echo "remaining fvpn-* connections: $remaining"
[[ "$remaining" == "0" ]] || die "some connections survived — inspect manually"
