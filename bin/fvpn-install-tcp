#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# fvpn-install-tcp — add a TCP connection alongside each UDP one
#
# A NetworkManager VPN connection's transport is fixed at import time, so
# offering a UDP/TCP choice needs two connections per location:
#
#     fvpn-<id>       UDP  (the default)
#     fvpn-<id>-tcp   TCP  (fallback for networks that block UDP)
#
# Credentials are untouched: connections are created at password-flags=2 and
# the password stays in the desktop keyring.
#
#   sudo bash fvpn-install-tcp            import the missing TCP connections
#   sudo bash fvpn-install-tcp --dry-run  list what would be imported
#   sudo bash fvpn-install-tcp --remove   delete every fvpn-*-tcp connection
# ---------------------------------------------------------------------------
set -uo pipefail

TARGET_USER="${SUDO_USER:-user16}"
OVPN_DIR=/etc/openvpn
SYSCONN_DIR=/etc/NetworkManager/system-connections
CERT_DIR=/etc/NetworkManager/certificates/fvpn

dry=0; remove=0
for a in "$@"; do
    case "$a" in
        --dry-run) dry=1 ;;
        --remove)  remove=1 ;;
        *) echo "usage: $0 [--dry-run] [--remove]" >&2; exit 2 ;;
    esac
done

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "must run as root (sudo bash $0)"
id -u "$TARGET_USER" >/dev/null 2>&1 || die "no such user: $TARGET_USER"
command -v python3 >/dev/null || die "python3 required"

if (( remove )); then
    mapfile -t gone < <(nmcli -t -f NAME connection show | grep -- '^fvpn-.*-tcp$')
    printf 'removing %d TCP connection(s)\n' "${#gone[@]}"
    for c in "${gone[@]}"; do nmcli connection delete id "$c" >/dev/null 2>&1 && echo "  removed $c"; done
    nmcli connection reload
    exit 0
fi

# Which transport does an existing connection use? A location whose primary is
# already TCP (br-04 is published TCP-only) needs no separate TCP copy.
primary_is_tcp() {
    nmcli -g vpn.data connection show "fvpn-$1" 2>/dev/null | grep -q 'proto-tcp[[:space:]]*=[[:space:]]*yes'
}

mapfile -t todo < <(
  for f in "$OVPN_DIR"/*-tcp.ovpn; do
      [[ -r "$f" ]] || continue
      id="$(basename "$f" -tcp.ovpn)"
      nmcli -t -f NAME connection show 2>/dev/null | grep -qx "fvpn-$id" || continue
      nmcli -t -f NAME connection show 2>/dev/null | grep -qx "fvpn-${id}-tcp" && continue
      primary_is_tcp "$id" && continue
      echo "$id"
  done
)

if (( ${#todo[@]} == 0 )); then
    echo "nothing to do — every location already has a TCP connection"
    exit 0
fi

printf 'will import %d TCP connection(s)\n' "${#todo[@]}"
if (( dry )); then printf '  %s\n' "${todo[@]}"; echo "(dry run — nothing changed)"; exit 0; fi

VPN_USERNAME="$(nmcli -g vpn.data connection show "$(nmcli -t -f NAME connection show \
    | grep -m1 '^fvpn-')" 2>/dev/null | tr ',' '\n' \
    | sed -n 's/^[[:space:]]*username[[:space:]]*=[[:space:]]*//p' | head -1 | tr -d '[:space:]')"
[[ -n "$VPN_USERNAME" ]] || die "could not determine the VPN username"

install -d -m 0755 -o root -g root "$CERT_DIR"
made=0; failed=0

for id in "${todo[@]}"; do
    staged="${id}-tcp"
    # nmcli names the import after the file, which is already what we want, but
    # clear any leftover of that name first so a re-run cannot duplicate.
    while nmcli -t -f NAME connection show 2>/dev/null | grep -qx "$staged"; do
        nmcli connection delete id "$staged" >/dev/null 2>&1 || break
    done
    if ! nmcli connection import type openvpn file "${OVPN_DIR}/${id}-tcp.ovpn" >/dev/null 2>&1; then
        echo "  FAIL $id"; (( failed++ )); continue
    fi
    nmcli connection modify id "$staged" connection.id "fvpn-${id}-tcp"            >/dev/null 2>&1
    nmcli connection modify id "fvpn-${id}-tcp" connection.autoconnect no          >/dev/null 2>&1
    nmcli connection modify id "fvpn-${id}-tcp" connection.permissions "user:${TARGET_USER}" >/dev/null 2>&1
    echo "  ok   fvpn-${id}-tcp"
    (( made++ ))
done

echo
echo "fixing certs, username and secret flags…"
CERT_DIR="$CERT_DIR" SYSCONN_DIR="$SYSCONN_DIR" VPN_USERNAME="$VPN_USERNAME" python3 <<'PY'
import configparser, glob, os, shutil
cdir = os.path.normpath(os.environ["CERT_DIR"])
user = os.environ["VPN_USERNAME"]
for kf in sorted(glob.glob(os.path.join(os.environ["SYSCONN_DIR"], "*.nmconnection"))):
    cp = configparser.RawConfigParser(); cp.optionxform = str
    try:
        with open(kf, encoding="utf-8") as fh: cp.read_file(fh)
    except Exception:
        continue
    if not cp.has_section("connection"): continue
    if not cp.get("connection", "id", fallback="").startswith("fvpn-"): continue
    if not cp.has_section("vpn"): continue
    changed = False
    for key in ("ca", "ta"):
        src = cp.get("vpn", key, fallback="")
        if not src: continue
        if src.startswith("/root/"):
            dst = os.path.join(cdir, os.path.basename(src))
            if os.path.isfile(src): shutil.move(src, dst)
            if os.path.isfile(dst):
                os.chmod(dst, 0o644); os.chown(dst, 0, 0)
                cp.set("vpn", key, dst); changed = True
        elif os.path.dirname(os.path.normpath(src)) == cdir and os.path.isfile(src):
            os.chmod(src, 0o644); os.chown(src, 0, 0)
    if cp.get("vpn", "username", fallback="") != user:
        cp.set("vpn", "username", user); changed = True
    if cp.get("vpn", "password-flags", fallback="") != "2":
        cp.set("vpn", "password-flags", "2"); changed = True
    if cp.has_section("vpn-secrets"):
        cp.remove_section("vpn-secrets"); changed = True
    if not changed: continue
    tmp = kf + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        cp.write(fh, space_around_delimiters=False)
    os.chmod(tmp, 0o600); os.chown(tmp, 0, 0)
    os.replace(tmp, kf)
print("  done")
PY

nmcli connection reload
echo
printf 'imported: %d   failed: %d\n' "$made" "$failed"
echo "TCP connections now: $(nmcli -t -f NAME connection show | grep -c -- '^fvpn-.*-tcp$')"
echo
echo "Then, as your user:  bin/fvpn-endpoints sync   (records them in the catalogue)"
