#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# fvpn-creds — manage the FastestVPN password in the desktop keyring
#
#   fvpn-creds store            prompt for the password and save it
#   fvpn-creds store --stdin    read the password from stdin (no TTY needed)
#   fvpn-creds status           report whether a credential is present
#   fvpn-creds forget           delete the saved credential
#
# FastestVPN uses one account across every location, so a single keyring entry
# covers all profiles. The secret is never passed as an argument and is never
# written to disk in the clear.
#
# --stdin exists for the plugin's config screen: omarchy-shell has no TTY, so
# the interactive `read -rs` below can never run there.
# ---------------------------------------------------------------------------
set -euo pipefail

SERVICE=fastestvpn

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

command -v secret-tool >/dev/null || die "secret-tool not found (install libsecret)"

# The account is supplied by the caller. The plugin passes the one configured in
# its settings; nothing here may depend on a file that only exists in one
# person's home directory.
account="${FVPN_ACCOUNT:-}"
if [[ -z "$account" ]] && command -v nmcli >/dev/null; then
    conn="$(nmcli -t -f NAME connection show 2>/dev/null | grep -m1 '^fvpn-' || true)"
    if [[ -n "$conn" ]]; then
        account="$(nmcli -g vpn.data connection show "$conn" 2>/dev/null | tr ',' '\n' \
            | sed -n 's/^[[:space:]]*username[[:space:]]*=[[:space:]]*//p' | head -1 | tr -d '[:space:]')"
    fi
fi
[[ -n "$account" ]] || die "no account name; export FVPN_ACCOUNT or set one in the plugin's settings"

case "${1:-}" in
    store)
        if [[ "${2:-}" == "--stdin" ]]; then
            # A single line, so a trailing newline from the caller is stripped
            # rather than stored as part of the secret. `read` returns non-zero
            # at EOF without a newline, which is the normal case here.
            IFS= read -r password || true
        else
            [[ -t 0 ]] || die "no terminal; use: ${0##*/} store --stdin"
            printf 'FastestVPN password for %s: ' "$account" >&2
            IFS= read -rs password
            printf '\n' >&2
        fi
        [[ -n "$password" ]] || die "password was empty"
        printf '%s' "$password" \
          | secret-tool store --label="FastestVPN ($account)" \
              service "$SERVICE" account "$account"
        unset password
        echo "stored in keyring for $account"
        ;;
    status)
        if secret-tool lookup service "$SERVICE" account "$account" >/dev/null 2>&1; then
            echo "credential present for $account"
        else
            echo "no credential stored for $account"; exit 1
        fi
        ;;
    forget)
        secret-tool clear service "$SERVICE" account "$account" 2>/dev/null || true
        echo "cleared keyring entry for $account"
        ;;
    *)
        echo "usage: ${0##*/} {store [--stdin]|status|forget}" >&2; exit 2 ;;
esac
