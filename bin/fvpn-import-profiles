#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# fvpn-import-profiles — import a directory of .ovpn files into NetworkManager
#
#   bash fvpn-import-profiles --dir DIR --account EMAIL
#   ... --dry-run                    list what would be imported
#
# UNPRIVILEGED. This script must never be run as root, and nothing in this
# plugin escalates. NetworkManager is the only component that needs privilege,
# and it already has it: stock Arch ships
# /usr/share/polkit-1/rules.d/org.freedesktop.NetworkManager.rules, which grants
# org.freedesktop.NetworkManager.settings.modify.system to a local user in the
# wheel group with no prompt. So the whole import runs as you.
#
# That is not merely safer, it is the only arrangement that can work from the
# panel: omarchy-shell is a long-lived process with no TTY, and Omarchy ships no
# polkit authentication agent, so an escalation prompt could never be answered.
#
# It also removes the reason the old version needed root at all. Imported as the
# user, NetworkManager extracts the inline <ca>/<tls-auth> blobs to
# $XDG_DATA_HOME/networkmanagement/certificates/nm-openvpn/ at 0600, owned by
# you, and activation still works because the OpenVPN service declares
# supports-safe-private-file-access=true — NM opens the certificate on the
# activating user's behalf. Only a root import had to copy certificates out of
# /root into a world-readable directory.
#
# Connections are created at password-flags=2, so no secret is written to disk;
# the password stays in the keyring and is supplied per activation.
#
# UNTRUSTED SOURCE. --dir is user-writable and predictable, so no tool is ever
# pointed straight at a path inside it. Each profile is copied out through a
# no-follow, non-blocking, byte-bounded read into a private staging directory,
# and nmcli only ever sees the staged copy under a name this script chose.
# ---------------------------------------------------------------------------
set -uo pipefail

MAX_BYTES=262144   # a profile is ~4KB; this bounds a swollen or endless file
NM_ACTION=org.freedesktop.NetworkManager.settings.modify.system

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

dir=""; account=""; dry=0
while (( $# )); do
    case "$1" in
        --dir)     dir="${2:-}"; shift 2 ;;
        --account) account="${2:-}"; shift 2 ;;
        --dry-run) dry=1; shift ;;
        *) echo "usage: $0 --dir DIR --account EMAIL [--dry-run]" >&2; exit 2 ;;
    esac
done

(( EUID != 0 )) || die "do not run this as root; it is meant to run as your own user"
[[ -n "$dir" ]]     || die "--dir is required"
[[ -n "$account" ]] || die "--account is required"
[[ "$account" =~ ^[A-Za-z0-9._%+-]+@?[A-Za-z0-9.-]*$ ]] || die "implausible account: $account"
command -v nmcli >/dev/null || die "nmcli not found"
[[ -e /usr/lib/NetworkManager/nm-openvpn-service ]] \
  || [[ -e /usr/lib/NetworkManager/VPN/nm-openvpn-service.name ]] \
  || die "networkmanager-openvpn is not installed"

me="$(id -un)" || die "cannot determine the current user"

# Say up front when the polkit rule does not apply — a non-wheel or remote
# session gets auth_admin_keep instead, and with no agent installed there is
# nothing to answer it. Advisory only: nmcli remains the authority, so a system
# that *does* run an agent can still authenticate normally.
if command -v pkcheck >/dev/null 2>&1; then
    if ! pkcheck --action-id "$NM_ACTION" --process $$ >/dev/null 2>&1; then
        echo "note: this session is not pre-authorised to add system connections." >&2
        echo "      That rule covers a local user in the 'wheel' group. If the" >&2
        echo "      import fails, have $me added to that group and log back in," >&2
        echo "      or run the import from a local session rather than remotely." >&2
        echo >&2
    fi
fi

# ── Read the profile directory ──────────────────────────────────────────────
# -type f is false for a symlink, so a planted link is skipped rather than
# followed, and find never descends out of the directory.
[[ -d "$dir" && ! -L "$dir" ]] || die "not a directory (or is a symlink): $dir"

mapfile -t names < <(
  find "$dir" -maxdepth 1 -type f -name '*.ovpn' -printf '%f\n' 2>/dev/null | sort
)

# Say so when something matching *.ovpn was passed over for not being a regular
# file. A skip that prints nothing is indistinguishable from a file that was
# never there, and that difference is exactly what costs an afternoon later.
mapfile -t irregular < <(
  find "$dir" -maxdepth 1 ! -type d ! -type f -name '*.ovpn' -printf '%f (%y)\n' 2>/dev/null | sort
)
if (( ${#irregular[@]} )); then
    echo "skipped ${#irregular[@]} entr(ies) that are not regular files:" >&2
    printf '  %s\n' "${irregular[@]}" >&2
    echo >&2
fi

(( ${#names[@]} )) || die "no .ovpn files in $dir"

stage="$(mktemp -d "${TMPDIR:-/tmp}/fvpn-import.XXXXXX")" || die "cannot create a staging directory"
chmod 0700 "$stage"
trap 'rm -rf -- "$stage"' EXIT

# nofollow refuses a symlink, nonblock keeps a planted FIFO from wedging us, and
# the byte bound caps a swollen or endless file.
read_guarded() {
    dd if="$1" iflag=nofollow,nonblock bs="$MAX_BYTES" count=1 2>/dev/null
}

# ── Work out the connection name each file wants ────────────────────────────
# Bundle files are <id>-udp.ovpn / <id>-tcp.ovpn. A file dropped in by hand may
# be named anything, so fall back to its `proto` line. UDP takes the plain name
# and TCP gets the -tcp suffix, which is what the UI expects.
declare -A want_conn=()
for base in "${names[@]}"; do
    [[ "$base" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}\.ovpn$ ]] || {
        echo "  skip (bad name): $base" >&2; continue
    }
    stem="${base%.ovpn}"
    case "$stem" in
        *-udp) id="${stem%-udp}"; proto=udp ;;
        *-tcp) id="${stem%-tcp}"; proto=tcp ;;
        *)     id="$stem"
               proto="$(read_guarded "$dir/$base" \
                        | sed -n 's/^[[:space:]]*proto[[:space:]]\+\([a-z]*\).*/\1/p' | head -1)"
               proto="${proto:-udp}" ;;
    esac
    [[ "$proto" == tcp* ]] && proto=tcp || proto=udp
    [[ "$id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || { echo "  skip (bad id): $base" >&2; continue; }
    conn="fvpn-$id"; [[ "$proto" == tcp ]] && conn="fvpn-$id-tcp"
    want_conn["$base"]="$conn"
done
(( ${#want_conn[@]} )) || die "no usable profiles in $dir"

existing() { nmcli -t -f NAME connection show 2>/dev/null | grep -qx "$1"; }

todo=(); skipped=0
for base in "${!want_conn[@]}"; do
    if existing "${want_conn[$base]}"; then skipped=$((skipped + 1)); continue; fi
    todo+=("$base")
done
IFS=$'\n' todo=($(sort <<<"${todo[*]:-}")); unset IFS

printf 'profiles found     : %d\n' "${#want_conn[@]}"
printf 'already imported   : %d\n' "$skipped"
printf 'to import          : %d\n' "${#todo[@]}"

if (( dry )); then echo; echo "(dry run — nothing changed)"; exit 0; fi
(( ${#todo[@]} )) || { echo "nothing to do"; exit 0; }
echo

imported=0; failed=0
for base in "${todo[@]}"; do
    conn="${want_conn[$base]}"
    # Stage under the name we want the connection to have: nmcli names the
    # connection after the file stem, and NM derives the certificate filenames
    # from it too, so importing as fvpn-<id> both skips a rename and keeps the
    # extracted certificates identifiable as ours.
    staged="$stage/$conn.ovpn"

    if ! read_guarded "$dir/$base" > "$staged"; then
        echo "  FAIL $base (unreadable)"; rm -f -- "$staged"; failed=$((failed + 1)); continue
    fi
    if ! grep -q '^[[:space:]]*remote[[:space:]]' "$staged"; then
        echo "  FAIL $base (no remote line — not an OpenVPN profile)"
        rm -f -- "$staged"; failed=$((failed + 1)); continue
    fi

    if ! nmcli connection import type openvpn file "$staged" >/dev/null 2>&1; then
        echo "  FAIL $base (import)"; rm -f -- "$staged"; failed=$((failed + 1)); continue
    fi
    rm -f -- "$staged"

    # autoconnect off (this is a manual, per-click VPN), restrict the connection
    # to this user, and set the account with the password NOT saved: flag 2 is
    # NOT_SAVED, so NM asks an agent per activation and fvpn-connect supplies it
    # from the keyring for exactly one attempt.
    nmcli connection modify id "$conn" connection.autoconnect no          >/dev/null 2>&1
    nmcli connection modify id "$conn" connection.permissions "user:$me"  >/dev/null 2>&1
    nmcli connection modify id "$conn" +vpn.data "username=$account,password-flags=2" >/dev/null 2>&1
    echo "  ok   $conn"
    imported=$((imported + 1))
done

nmcli connection reload >/dev/null 2>&1
echo
printf 'imported: %d   failed: %d\n' "$imported" "$failed"
echo "total fvpn-* connections: $(nmcli -t -f NAME connection show | grep -c '^fvpn-')"
