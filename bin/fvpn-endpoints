#!/usr/bin/env python3
"""Keep the FastestVPN endpoint catalogue current.

  fvpn-endpoints check              download the upstream bundle, report the diff
  fvpn-endpoints sync               merge upstream into locations.json
  fvpn-endpoints enrich [--limit N] fill in missing geo/reachability
  fvpn-endpoints status             summarise the catalogue

Enrichment geolocates each server's OWN IP (ipinfo.io/<ip>/json) rather than
connecting through it. That is deliberate: routing the user's traffic through
every endpoint in turn just to learn where it is would hijack their network for
minutes at a time. Spot-checked against a connected measurement — for uk2 both
methods returned 51.5085,-0.1257 — so the cheap method is also the accurate one.

An entry becomes selectable (status "complete") only once it has a resolved
host, a reachable port and coordinates. Everything else stays visible but
disabled, so a half-known endpoint can never be picked.
"""
import argparse, io, json, os, re, socket, subprocess, sys, time, urllib.request, zipfile

REPO   = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TABLE  = os.path.join(REPO, "data", "locations.json")
BUNDLE = "https://support.fastestvpn.com/download/fastestvpn_ovpn/"
UA     = "Mozilla/5.0 (X11; Linux x86_64)"
PROBE_PORT_DEFAULT = 4443
GEO_PAUSE = 1.2          # be polite to the geolocation API

ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


# ── upstream bundle ─────────────────────────────────────────────────────────
def fetch_bundle():
    req = urllib.request.Request(BUNDLE, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=60) as fh:
        raw = fh.read()
    if not raw.startswith(b"PK"):
        raise SystemExit("upstream did not return a zip archive")
    return zipfile.ZipFile(io.BytesIO(raw))


def parse_bundle(zf, report_skipped=False):
    """prefix -> {protocols, host, port, kind}

    Only `<id>-udp.ovpn` / `<id>-tcp.ovpn` are understood. As of 2026-09-05 that
    is every one of the bundle's 134 entries, but a silent `continue` would hide
    it if upstream ever added another naming or protocol — so anything skipped is
    reported rather than dropped.
    """
    out = {}
    skipped = []
    for name in zf.namelist():
        base = os.path.basename(name)
        if not base or name.endswith("/"):
            continue
        m = re.match(r"^(.+)-(tcp|udp)\.ovpn$", base)
        if not m:
            skipped.append(base)
            continue
        prefix, proto = m.group(1), m.group(2)
        if not ID_RE.match(prefix):
            continue
        rec = out.setdefault(prefix, {"protocols": [], "host": None,
                                      "port": PROBE_PORT_DEFAULT, "kind": None})
        if proto not in rec["protocols"]:
            rec["protocols"].append(proto)
        if rec["host"] is None:
            try:
                body = zf.read(name).decode("utf-8", "ignore")
            except Exception:
                body = ""
            r = re.search(r"^remote\s+(\S+)\s+(\d+)", body, re.M)
            if r:
                rec["host"] = r.group(1)
                try:
                    rec["port"] = int(r.group(2))
                except ValueError:
                    pass
    for prefix, rec in out.items():
        rec["protocols"].sort()
        rec["kind"] = ("multihop" if "-via-" in prefix
                       else "streaming" if "-stream" in prefix
                       else "standard")
    if report_skipped and skipped:
        print(f"  WARNING: {len(skipped)} bundle file(s) not in <id>-(udp|tcp).ovpn "
              f"form and therefore ignored:")
        for b in sorted(skipped)[:20]:
            print(f"    {b}")
        if len(skipped) > 20:
            print(f"    … and {len(skipped) - 20} more")
    return out


# ── support-site server table ───────────────────────────────────────────────
# The site renders one tab per protocol; only the active (PPTP) pane ships in
# the HTML, the rest come from admin-ajax. The tabs give authoritative country
# and city per hostname, plus which protocols each server speaks.
SITE_AJAX = "https://support.fastestvpn.com/wp-admin/admin-ajax.php"
SITE_TABS = {"pptp": "PPTP", "l2tp": "L2TP", "ikev2": "IKEv2", "tcp": "TCP",
             "udp": "UDP", "xsec": "IPSec", "ocp": "OpenConnect"}


def fetch_site_tabs():
    """host -> {country, city, protocols[]}; {} if the site is unreachable."""
    import urllib.parse
    out = {}
    for tab, label in SITE_TABS.items():
        body = urllib.parse.urlencode({"action": "vpn_servers", "protocol": tab})
        req = urllib.request.Request(
            SITE_AJAX, data=body.encode(), method="POST",
            headers={"User-Agent": UA,
                     "Content-Type": "application/x-www-form-urlencoded"})
        try:
            with urllib.request.urlopen(req, timeout=25) as fh:
                html = fh.read().decode("utf-8", "ignore")
        except Exception:
            continue
        for row in re.findall(r"<tr.*?</tr>", html, re.S):
            cells = [re.sub(r"<[^>]*>", "", c).replace("&nbsp;", " ").strip()
                     for c in re.findall(r"<td.*?</td>", row, re.S)]
            if len(cells) < 3 or not cells[2]:
                continue
            host = cells[2].lower()
            rec = out.setdefault(host, {"country": "", "city": "", "protocols": []})
            if cells[0] and not rec["country"]:
                rec["country"] = cells[0]
            if cells[1] and not rec["city"]:
                rec["city"] = cells[1]
            if label not in rec["protocols"]:
                rec["protocols"].append(label)
    for rec in out.values():
        rec["protocols"].sort()
    return out


# ── enrichment primitives ───────────────────────────────────────────────────
def resolve(host):
    try:
        return socket.gethostbyname(host)
    except Exception:
        return None


def port_open(ip, port, timeout=4.0):
    try:
        with socket.create_connection((ip, port), timeout=timeout):
            return True
    except Exception:
        return False


def geolocate(ip):
    for url, shape in (
        (f"https://ipinfo.io/{ip}/json", "ipinfo"),
        (f"http://ip-api.com/json/{ip}?fields=status,lat,lon,city,regionName,countryCode,isp", "ipapi"),
    ):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=12) as fh:
                d = json.loads(fh.read().decode("utf-8", "ignore"))
        except Exception:
            continue
        if shape == "ipinfo":
            loc = d.get("loc") or ""
            try:
                lat, lon = [float(x) for x in loc.split(",")]
            except Exception:
                continue
            return {"latitude": lat, "longitude": lon, "city": d.get("city"),
                    "countryCode": (d.get("country") or "").upper(),
                    "org": d.get("org")}
        if d.get("status") != "success":
            continue
        try:
            lat, lon = float(d["lat"]), float(d["lon"])
        except Exception:
            continue
        return {"latitude": lat, "longitude": lon, "city": d.get("city"),
                "countryCode": (d.get("countryCode") or "").upper(),
                "org": d.get("isp")}
    return None


def apply_mismatch(rec):
    """claimed (from the profile name) vs measured (from geolocation)."""
    claimed = (rec.get("countryCode") or "").upper()
    measured = (rec.get("measuredCountryCode") or "").upper()
    if claimed and measured and claimed != measured:
        rec["countryMismatch"] = {"claimed": claimed, "measured": measured,
                                  "measuredCity": rec.get("measuredCity") or rec.get("city")}
    elif measured:
        rec.pop("countryMismatch", None)


def derive_status(rec):
    if rec.get("retired"):
        return "retired"
    if not rec.get("host"):
        return "no-host"

    # A real OpenVPN connection attempt outranks the TCP probe. The probe is
    # wrong in BOTH directions and must not be treated as authoritative:
    #   india-stream      probes DOWN on tcp/4443 but connects fine over UDP
    #   germany-frankfurt probes UP but never answers OpenVPN (TLS timeout)
    # Only conclusive verdicts are stored here — an AUTH_FAILED is the
    # provider's session limit talking, not evidence about the server.
    verdict = (rec.get("verified") or {}).get("result")
    if verdict == "no-response":
        return "unreachable"
    # The server answers but refuses these credentials — a different failure
    # from a dead endpoint, and not something a retry will fix. Only recorded
    # after repeated rejections while other endpoints were connecting fine,
    # since a single AUTH_FAILED is usually the provider's session limit.
    if verdict == "auth-rejected":
        return "auth-rejected"
    if verdict != "ok":
        if rec.get("reachable") is False:
            return "unreachable"
        if rec.get("reachable") is None:
            return "pending"
    lat, lon = rec.get("latitude"), rec.get("longitude")
    if lat is None or lon is None:
        return "no-geo"
    if rec.get("precision") in (None, "", "country") and not rec.get("geoChecked"):
        return "pending"
    return "complete"


# ── table io ────────────────────────────────────────────────────────────────
def load_table():
    with open(TABLE, encoding="utf-8") as fh:
        return json.load(fh)


def save_table(doc):
    tmp = TABLE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(doc, fh, indent=2, ensure_ascii=True)
        fh.write("\n")
    os.replace(tmp, TABLE)


# Country claimed by a profile's own name. Needed for two reasons: a decent
# label, and something to compare the measured country against — without a
# claimed value, an endpoint labelled "switzerland" that geolocates to the USA
# looks like agreement rather than the virtual location it is.
COUNTRY_BY_TOKEN = {
    "australia": ("Australia", "AU"), "austria": ("Austria", "AT"),
    "belgium": ("Belgium", "BE"), "brazil": ("Brazil", "BR"),
    "bulgaria": ("Bulgaria", "BG"), "canada": ("Canada", "CA"),
    "colombia": ("Colombia", "CO"), "czechia": ("Czechia", "CZ"),
    "denmark": ("Denmark", "DK"), "finland": ("Finland", "FI"),
    "france": ("France", "FR"), "germany": ("Germany", "DE"),
    "greece": ("Greece", "GR"), "hongkong": ("Hong Kong", "HK"),
    "hungary": ("Hungary", "HU"), "india": ("India", "IN"),
    "ireland": ("Ireland", "IE"), "italy": ("Italy", "IT"),
    "japan": ("Japan", "JP"), "luxembourg": ("Luxembourg", "LU"),
    "malaysia": ("Malaysia", "MY"), "mexico": ("Mexico", "MX"),
    "netherlands": ("Netherlands", "NL"), "norway": ("Norway", "NO"),
    "poland": ("Poland", "PL"), "portugal": ("Portugal", "PT"),
    "romania": ("Romania", "RO"), "russia": ("Russia", "RU"),
    "serbia": ("Serbia", "RS"), "singapore": ("Singapore", "SG"),
    "slovakia": ("Slovakia", "SK"), "southafrica": ("South Africa", "ZA"),
    "southkorea": ("South Korea", "KR"), "spain": ("Spain", "ES"),
    "sweden": ("Sweden", "SE"), "switzerland": ("Switzerland", "CH"),
    "turkey": ("Turkey", "TR"), "uae": ("United Arab Emirates", "AE"),
    "uk": ("United Kingdom", "GB"), "ukraine": ("Ukraine", "UA"),
    "usa": ("United States", "US"),
}

DISPLAY_TOKEN = {"uk": "UK", "usa": "USA", "uae": "UAE"}


def parse_prefix(pid):
    """id -> (country token, ordinal/suffix, kind, via token or None)"""
    via = None
    m = re.match(r"^(.+)-via-(.+)$", pid)
    if m:
        pid_head, via = m.group(1), m.group(2)
    else:
        pid_head = pid
    kind = "multihop" if via else ("streaming" if "-stream" in pid_head else "standard")
    head = re.sub(r"-stream\d*$", "", pid_head)
    m2 = re.match(r"^([a-z]+?)(\d+)$", head)
    if m2 and m2.group(1) in COUNTRY_BY_TOKEN:
        return m2.group(1), m2.group(2), kind, via
    if head in COUNTRY_BY_TOKEN:
        return head, "", kind, via
    # e.g. usa-ashburn, germany-frankfurt: token is the leading segment
    lead = head.split("-", 1)[0]
    if lead in COUNTRY_BY_TOKEN:
        return lead, head.split("-", 1)[1] if "-" in head else "", kind, via
    return head, "", kind, via


def claimed_country(pid):
    token, _, _, _ = parse_prefix(pid)
    return COUNTRY_BY_TOKEN.get(token, (None, None))


def title_from_prefix(pid):
    token, suffix, kind, via = parse_prefix(pid)
    name = COUNTRY_BY_TOKEN.get(token, (None, None))[0] \
        or DISPLAY_TOKEN.get(token) or token.replace("_", " ").title()
    label = name
    if suffix:
        label += " - " + (suffix.replace("-", " ").title() if not suffix.isdigit()
                          else suffix)
    if kind == "streaming":
        label += " (Streaming)"
    if via:
        vname = COUNTRY_BY_TOKEN.get(via, (None, None))[0] \
            or DISPLAY_TOKEN.get(via) or via.title()
        label += " (via %s)" % vname
    return label


def derive_via(locations):
    """Attach the entry node to `<exit>-via-<entry>` profiles.

    The entry token names a country, not a profile, so it is resolved against
    whichever sibling location already has coordinates for that country. This
    stays a best effort: if no sibling is placed yet, `via` is simply left off
    rather than invented, and the map draws no link.
    """
    placed = [r for r in locations
              if r.get("latitude") is not None and not r.get("retired")]
    n = 0
    for r in locations:
        m = re.match(r"^(.+)-via-(.+)$", r["id"])
        if not m:
            continue
        token = m.group(2)
        # Match `uk` against uk1/uk2/uk-stream but NOT ukraine. A bare
        # startswith() does match ukraine, which put the France entry node in
        # Kyiv until this was tightened.
        pat = re.compile(r"^" + re.escape(token) + r"(\d+)?$")
        best = None
        for cand in sorted(placed, key=lambda c: c["id"]):   # deterministic
            cid = cand["id"]
            if cid == r["id"]:
                continue
            if not (pat.match(cid) or cid.startswith(token + "-")):
                continue
            # Prefer a plain standard endpoint over a streaming variant.
            if best is None or (cand.get("kind") == "standard"
                                and best.get("kind") != "standard"):
                best = cand
        if best is None:
            r.pop("via", None)
            continue
        r["via"] = {
            "label": best.get("country") or token.title(),
            "country": best.get("country") or token.title(),
            "countryCode": best.get("countryCode") or "",
            "city": best.get("city"),
            "latitude": best["latitude"],
            "longitude": best["longitude"],
            "derivedFrom": best["id"],
        }
        n += 1
    return n


# ── config generation for site-only hosts ───────────────────────────────────
GEN_DIR = os.path.join(REPO, "data", "generated")


def bundle_template(zf):
    """A bundle .ovpn with its `remote` line replaced by a {remote} slot.

    Safe because every profile in the bundle is byte-identical apart from that
    line: verified 67/67 share one CA blob, one tls-auth blob and one option
    set. If that ever stops being true this returns None and generation is
    refused rather than silently emitting a wrong config.
    """
    bodies = {}
    for name in zf.namelist():
        if not name.endswith("-udp.ovpn"):
            continue
        try:
            b = zf.read(name).decode("utf-8", "ignore")
        except Exception:
            continue
        norm = re.sub(r"^remote\s+\S+\s+\d+\s*$", "{remote}", b, flags=re.M)
        bodies.setdefault(norm, []).append(name)
    if len(bodies) != 1:
        return None, len(bodies)
    return next(iter(bodies)), 1


def slug_for(host, country, city, taken):
    """Id for a generated endpoint, taken from the HOSTNAME stem.

    Deliberately not from the site's country/city: the operator's table lists
    hk-dbl.jumptoserver.com as Canada/Montreal, which would produce the id
    "canada-montreal2" for an obviously Hong Kong host. The hostname is the one
    field that is unambiguous and traceable back to the server; country and city
    still populate the record for display.
    """
    cand = re.sub(r"[^a-z0-9]+", "-", host.split(".")[0].lower()).strip("-")
    cand = cand[:60] or "endpoint"
    if cand not in taken:
        return cand
    i = 2
    while f"{cand}{i}" in taken:
        i += 1
    return f"{cand}{i}"


def cmd_generate(args):
    zf = fetch_bundle()
    up = parse_bundle(zf)
    tpl, nvariants = bundle_template(zf)
    if tpl is None:
        raise SystemExit(f"bundle profiles are not uniform ({nvariants} variants) — "
                         "refusing to generate configs from a template")

    site = fetch_site_tabs()
    if not site:
        raise SystemExit("support site unavailable — nothing to generate from")

    bundle_hosts = {(m["host"] or "").lower() for m in up.values()}
    doc = load_table()
    known_hosts = {(r.get("host") or "").lower() for r in doc["locations"]}
    taken = {r["id"] for r in doc["locations"]}

    missing = [(h, m) for h, m in sorted(site.items())
               if h not in bundle_hosts and h not in known_hosts
               and ("UDP" in m["protocols"] or "TCP" in m["protocols"])]
    if not missing:
        print("no site-only OpenVPN hosts to generate")
        return 0

    os.makedirs(GEN_DIR, exist_ok=True)
    print(f"generating {len(missing)} config(s) into {GEN_DIR}")
    made = 0
    for host, meta in missing:
        pid = slug_for(host, meta.get("country"), meta.get("city"), taken)
        taken.add(pid)
        for proto, port in (("udp", 4443), ("tcp", 4443)):
            if proto.upper() not in meta["protocols"]:
                continue
            body = tpl.replace("{remote}", f"remote {host} {port}")
            if proto == "tcp":
                body = body.replace("proto udp", "proto tcp")
            out = os.path.join(GEN_DIR, f"{pid}-{proto}.ovpn")
            with open(out, "w", encoding="utf-8") as fh:
                fh.write(body)
            os.chmod(out, 0o644)

        cname, ccode = claimed_country(pid)
        rec = {
            "id": pid,
            "connection": "fvpn-" + pid,
            "label": title_from_prefix(pid),
            "country": meta.get("country") or cname or "",
            "countryCode": ccode or "",
            "city": meta.get("city") or None,
            "latitude": None, "longitude": None, "precision": None,
            "host": host, "port": 4443,
            "protocols": [p.lower() for p in ("udp", "tcp") if p.upper() in meta["protocols"]],
            "kind": "multihop" if "-dbl" in host else "standard",
            "generated": True,
            "siteListed": True,
            "siteProtocols": meta["protocols"],
        }
        rec["status"] = derive_status(rec)
        doc["locations"].append(rec)
        made += 1
        print(f"  {pid:22s} {host:32s} {', '.join(meta['protocols'])}")

    doc["locations"].sort(key=lambda r: r["id"])
    save_table(doc)
    print(f"\ngenerated {made} endpoint(s); run `enrich` to probe and locate them,")
    print(f"then `sudo bash bin/fvpn-install-endpoints` to import them.")
    return 0


# ── commands ────────────────────────────────────────────────────────────────
def cmd_check(_args):
    up = parse_bundle(fetch_bundle(), report_skipped=True)
    doc = load_table()
    have = {r["id"] for r in doc["locations"]}
    generated = {r["id"] for r in doc["locations"] if r.get("generated")}
    new = sorted(set(up) - have)
    gone = sorted(have - set(up) - generated)
    print(f"upstream: {len(up)}   local: {len(have)}")
    print(f"  new upstream ({len(new)}): {' '.join(new) or '-'}")
    print(f"  retired      ({len(gone)}): {' '.join(gone) or '-'}")
    if generated:
        print(f"  locally generated, not in bundle ({len(generated)}): "
              f"{' '.join(sorted(generated))}")
    return 0


def cmd_sync(_args):
    up = parse_bundle(fetch_bundle(), report_skipped=True)
    doc = load_table()
    by_id = {r["id"]: r for r in doc["locations"]}
    added = retired = touched = 0

    site = fetch_site_tabs()
    if site:
        print(f"support site: {len(site)} hosts across {len(SITE_TABS)} protocol tabs")
    else:
        print("support site unavailable — continuing with bundle data only")

    for pid, meta in sorted(up.items()):
        r = by_id.get(pid)
        if r is None:
            cname, ccode = claimed_country(pid)
            r = {
                "id": pid,
                "connection": "fvpn-" + pid,
                "label": title_from_prefix(pid),
                "country": cname or "", "countryCode": ccode or "", "city": None,
                "latitude": None, "longitude": None,
                "precision": None,
            }
            by_id[pid] = r
            doc["locations"].append(r)
            added += 1
        if r.get("host") != meta["host"]:
            # Endpoint moved: previous geo no longer describes it.
            if r.get("host") is not None:
                r["reachable"] = None
                r["geoChecked"] = False
            touched += 1
        cname, ccode = claimed_country(pid)
        if ccode:
            r["countryCode"] = ccode
            r["country"] = cname
        r["host"] = meta["host"]
        r["port"] = meta["port"]
        r["protocols"] = meta["protocols"]
        r["kind"] = meta["kind"]
        r.pop("retired", None)

        # Site metadata: authoritative naming, and which protocols the server
        # speaks. `siteProtocols` is informational only — this plugin connects
        # over OpenVPN through NetworkManager, so PPTP/L2TP/IKEv2/IPSec/
        # OpenConnect availability does not make an endpoint usable here.
        sm = site.get((meta["host"] or "").lower())
        if sm:
            r["siteListed"] = True
            if sm["protocols"]:
                r["siteProtocols"] = sm["protocols"]
            if sm["country"]:
                r["siteCountry"] = sm["country"]
            if sm["city"]:
                # The operator's table is inconsistently cased ("milan").
                city = sm["city"]
                if city.islower() or city.isupper():
                    city = city.title()
                r["siteCity"] = city
                # Prefer the operator's own city over a guess, but never over a
                # coordinate we measured or geolocated ourselves.
                if r.get("precision") in (None, "", "country", "city"):
                    r["city"] = city
        else:
            r["siteListed"] = False

    for pid, r in by_id.items():
        if pid in up:
            continue
        # Locally generated endpoints are absent from the bundle by definition —
        # retiring them would silently un-select a working location (br-04).
        if r.get("generated"):
            r.pop("retired", None)
            continue
        r["retired"] = True
        retired += 1

    for r in doc["locations"]:
        # Replace a label that is just the id title-cased (e.g. "Switzerland Via
        # Usa") with a properly formatted one; hand-set labels are left alone.
        naive = r["id"].replace("-", " ").replace("_", " ").title()
        if r.get("label") in (None, "", naive):
            r["label"] = title_from_prefix(r["id"])
        apply_mismatch(r)
        r["status"] = derive_status(r)

    derive_via(doc["locations"])
    doc["locations"].sort(key=lambda r: r["id"])
    save_table(doc)
    print(f"added {added}, retired {retired}, endpoint changed {touched}")
    print(f"pending enrichment: {sum(1 for r in doc['locations'] if r['status'] == 'pending')}")
    return 0


def cmd_enrich(args):
    doc = load_table()
    todo = [r for r in doc["locations"]
            if not r.get("retired")
            and (derive_status(r) in ("pending", "no-geo")
                 or (r.get("reachable") and not r.get("measuredCountryCode")))]
    if args.limit:
        todo = todo[: args.limit]
    if not todo:
        print("nothing to enrich")
        return 0

    print(f"enriching {len(todo)} endpoint(s)")
    for r in todo:
        host = r.get("host")
        if not host:
            r["status"] = "no-host"
            continue
        ip = resolve(host)
        r["ip"] = ip
        if not ip:
            r["reachable"] = False
            r["geoChecked"] = True
            r["status"] = "unreachable"
            print(f"  {r['id']:24s} DNS failed")
            continue

        r["reachable"] = port_open(ip, int(r.get("port") or PROBE_PORT_DEFAULT))
        if (r.get("verified") or {}).get("result") == "ok" and not r["reachable"]:
            print(f"  {r['id']:24s} {ip:16s} probe says down, but a real connect "
                  f"succeeded — trusting the connect")
        elif not r["reachable"]:
            r["geoChecked"] = True
            r["status"] = "unreachable"
            print(f"  {r['id']:24s} {ip:16s} unreachable")
            continue

        # Never downgrade a coordinate measured through a live tunnel.
        if r.get("precision") == "measured":
            r["geoChecked"] = True
            r["status"] = derive_status(r)
            print(f"  {r['id']:24s} {ip:16s} reachable (keeping measured geo)")
            continue

        g = geolocate(ip)
        time.sleep(GEO_PAUSE)
        if not g:
            r["geoChecked"] = True
            r["status"] = "no-geo"
            print(f"  {r['id']:24s} {ip:16s} reachable, no geolocation")
            continue

        r["latitude"] = g["latitude"]
        r["longitude"] = g["longitude"]
        if g.get("city"):
            r["city"] = g["city"]
        if g.get("countryCode"):
            r["measuredCountryCode"] = g["countryCode"]
            r["measuredCity"] = g.get("city")
        r["precision"] = "server"
        r["serverOrg"] = g.get("org")
        r["geoChecked"] = True
        r["status"] = derive_status(r)
        print(f"  {r['id']:24s} {ip:16s} {g.get('city') or '?'}, {g['countryCode']}"
              f"  ({g['latitude']:.4f},{g['longitude']:.4f})")

    for r in doc["locations"]:
        apply_mismatch(r)
        r["status"] = derive_status(r)
    v = derive_via(doc["locations"])
    save_table(doc)
    print(f"saved ({v} multi-hop entry node(s) resolved)")
    return 0


def nm_remote(pid):
    """The host a NetworkManager connection actually dials, or None.

    nmcli escapes both ':' and ',' with backslashes in vpn.data, so the value
    needs unescaping before it can be compared — missing that made every
    connection look stale.
    """
    try:
        out = subprocess.run(["nmcli", "-g", "vpn.data", "connection", "show",
                              "fvpn-" + pid], capture_output=True, text=True)
    except Exception:
        return None
    if out.returncode != 0:
        return None
    for part in out.stdout.split(","):
        m = re.match(r"\s*remote\s*=\s*(\S+)", part)
        if m:
            return m.group(1).replace("\\", "").split(":")[0].lower()
    return None


def stale_connections(locations):
    """Entries whose NM connection dials a different host than the catalogue.

    `sync` updates the catalogue from the bundle, but an existing NM connection
    keeps whatever `remote` it was imported with. When upstream moves an
    endpoint the two drift apart, and any connect test then exercises the wrong
    server — which is how india-stream came back "ok" while actually dialling
    india1's host.
    """
    out = []
    for r in locations:
        if r.get("retired") or not r.get("host"):
            continue
        rem = nm_remote(r["id"])
        if rem is None:
            continue
        if rem != r["host"].lower():
            out.append((r["id"], rem, r["host"]))
    return out


def cmd_status(_args):
    doc = load_table()
    from collections import Counter
    L = doc["locations"]
    print(f"locations: {len(L)}")
    print("  by status:", dict(Counter(r.get("status") or derive_status(r) for r in L)))
    print("  by kind:  ", dict(Counter(r.get("kind") or "?" for r in L)))
    print("  by precision:", dict(Counter(str(r.get("precision")) for r in L)))
    sel = [r for r in L if (r.get("status") or derive_status(r)) == "complete"]
    print(f"  selectable: {len(sel)}")
    ver = [r for r in L if r.get("verified")]
    print(f"  with a real connect verdict: {len(ver)}")

    stale = stale_connections(L)
    if stale:
        print(f"\n  STALE NetworkManager connections ({len(stale)}) — these dial an")
        print("  outdated host, so both connecting and verifying use the wrong server.")
        print("  Fix with: sudo bash bin/fvpn-install-endpoints --reimport")
        for pid, rem, host in stale:
            print(f"    {pid:22s} dials {rem:28s} should be {host}")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("check")
    sub.add_parser("sync")
    e = sub.add_parser("enrich"); e.add_argument("--limit", type=int, default=0)
    sub.add_parser("status")
    sub.add_parser("generate")
    args = ap.parse_args()
    return {"check": cmd_check, "sync": cmd_sync, "enrich": cmd_enrich,
            "status": cmd_status, "generate": cmd_generate}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
