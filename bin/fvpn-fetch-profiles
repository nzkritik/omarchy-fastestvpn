#!/usr/bin/python3 -I
"""fvpn-fetch-profiles — fill the profile directory from FastestVPN's bundle.

    fvpn-fetch-profiles [--dir DIR] [--dry-run]

Runs unprivileged, as the user, into a user-owned directory. The bundle is the
vendor's published OpenVPN archive; it is served directly, with no HTML page in
front of it.

This replaces the old download-inside-the-root-importer arrangement: the
importer now only ever reads the directory, so fetching needs no privilege and
the user can equally well drop their own .ovpn files in by hand.

DATA ONLY. The download is held in memory and parsed here as a zip. It never
touches the filesystem and is never handed to another program; the only thing
that leaves this process is .ovpn text written into the profile directory.

BOUNDED. The request is HTTPS-only, redirects included, with certificate
verification, at most 3 redirects, an 8 MiB cap enforced while reading, and a
90 s deadline. Extraction never trusts the sizes the archive declares: each
member is read from the decompressed stream with a byte bound, and the total is
capped, so a hostile or corrupt archive cannot expand without limit. The real
bundle is ~300 KB holding 134 profiles of ~3 KB each; every limit sits far above
that.
"""

import argparse
import io
import os
import re
import secrets
import ssl
import stat
import sys
import time
import urllib.error
import urllib.request
import zipfile

BUNDLE_URL = "https://support.fastestvpn.com/download/fastestvpn_ovpn/"
MAX_BUNDLE = 8 * 1048576
MAX_REDIRECTS = 3
DEADLINE_SECS = 90
MAX_ENTRIES = 1000
MAX_PROFILE = 262144          # matches the importer's per-file bound
MAX_TOTAL = 16 * 1048576
MODE = 0o644
# The filename becomes a connection id later, so validate it here rather than
# trusting whatever the archive happened to contain.
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}\.ovpn$")


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def default_dir():
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "share")
    return os.path.join(base, "fastestvpn", "profiles")


# ── Download ─────────────────────────────────────────────────────────────────
class HttpsOnlyRedirects(urllib.request.HTTPRedirectHandler):
    """Follow at most MAX_REDIRECTS, and only to https:// (urllib has already
    resolved a relative Location against the request by the time this runs)."""
    max_redirections = MAX_REDIRECTS

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not newurl.lower().startswith("https://"):
            raise urllib.error.URLError(f"refusing a redirect to non-HTTPS {newurl}")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def download():
    opener = urllib.request.build_opener(
        urllib.request.HTTPSHandler(context=ssl.create_default_context()),
        HttpsOnlyRedirects)
    req = urllib.request.Request(BUNDLE_URL, headers={"User-Agent": "Mozilla/5.0"})
    deadline = time.monotonic() + DEADLINE_SECS
    try:
        with opener.open(req, timeout=30) as resp:
            if not resp.geturl().lower().startswith("https://"):
                die("download ended on a non-HTTPS URL")
            declared = resp.headers.get("Content-Length", "")
            if declared.isdigit() and int(declared) > MAX_BUNDLE:
                die(f"bundle is {declared} bytes; refusing more than {MAX_BUNDLE}")
            buf = bytearray()
            while True:
                if time.monotonic() > deadline:
                    die(f"download took longer than {DEADLINE_SECS}s")
                chunk = resp.read(65536)
                if not chunk:
                    break
                buf += chunk
                if len(buf) > MAX_BUNDLE:
                    die(f"bundle exceeds {MAX_BUNDLE} bytes; refusing it")
            return bytes(buf)
    except urllib.error.HTTPError as e:
        die(f"download failed: HTTP {e.code}")
    except (urllib.error.URLError, OSError) as e:
        die(f"download failed: {getattr(e, 'reason', e)}")


# ── Profile directory ────────────────────────────────────────────────────────
# Every read and write goes through a directory descriptor opened without
# following a link, so no path component can be swapped out from under us.
def read_existing(dfd, name):
    """The current profile, read no-follow, non-blocking and bounded. Returns
    (None, False) for anything that is not a regular file. The flag says an
    identical copy is too permissive: older versions extracted with the
    archive's own 0666."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
    except OSError:
        return None, False
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > MAX_PROFILE:
            return None, False
        chunks, left = [], MAX_PROFILE + 1
        while left > 0:
            b = os.read(fd, left)
            if not b:
                break
            chunks.append(b)
            left -= len(b)
        return b"".join(chunks), stat.S_IMODE(st.st_mode) != MODE
    finally:
        os.close(fd)


def tighten(dfd, name):
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
    try:
        if stat.S_ISREG(os.fstat(fd).st_mode):
            os.fchmod(fd, MODE)
    finally:
        os.close(fd)


def publish(dfd, name, data):
    """Exclusive temp file beside the target, then an atomic rename over it. A
    symlink or FIFO planted at `name` is replaced, never followed or opened."""
    for _ in range(16):
        # Dot-prefixed and not ending in .ovpn: a crash cannot leave a
        # half-written file that the importer would pick up.
        tmpname = f".{name}.{secrets.token_hex(6)}.part"
        try:
            fd = os.open(tmpname, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         MODE, dir_fd=dfd)
            break
        except FileExistsError:
            continue
    else:
        die("could not create a temporary file in the profile directory")
    try:
        os.fchmod(fd, MODE)
        view = memoryview(data)
        while view:
            view = view[os.write(fd, view):]
        os.fsync(fd)
        os.close(fd)
        os.replace(tmpname, name, src_dir_fd=dfd, dst_dir_fd=dfd)
    except BaseException:
        try:
            os.close(fd)
        except OSError:
            pass
        try:
            os.unlink(tmpname, dir_fd=dfd)
        except OSError:
            pass
        raise


# ── Extraction ───────────────────────────────────────────────────────────────
def extract(bundle, dfd, dry):
    """Install every acceptable .ovpn from the in-memory zip `bundle`. Returns
    (added, same, tightened)."""
    try:
        zf = zipfile.ZipFile(io.BytesIO(bundle))
    except zipfile.BadZipFile:
        die("upstream did not return a zip")
    members = zf.infolist()
    if len(members) > MAX_ENTRIES:
        die(f"bundle has {len(members)} entries; refusing more than {MAX_ENTRIES}")

    added = same = tightened = 0
    total = 0
    seen = set()
    for m in members:
        if m.is_dir():
            continue
        base = m.filename.rsplit("/", 1)[-1]
        if not base.endswith(".ovpn"):
            continue
        if not NAME_RE.match(base) or base in seen:
            print(f"  skip (bad or duplicate name): {base!r}")
            continue
        seen.add(base)
        # Bounded read of the decompressed stream: the declared size is the
        # archive's claim, and a hostile header can understate it.
        try:
            with zf.open(m) as fh:
                data = fh.read(MAX_PROFILE + 1)
        except (zipfile.BadZipFile, NotImplementedError, RuntimeError, OSError) as e:
            print(f"  skip (unreadable): {base} ({e})")
            continue
        if len(data) > MAX_PROFILE:
            print(f"  skip (larger than {MAX_PROFILE} bytes): {base}")
            continue
        total += len(data)
        if total > MAX_TOTAL:
            die(f"bundle expands past {MAX_TOTAL} bytes; refusing it")

        current, loose = read_existing(dfd, base)
        if current == data:
            same += 1
            if loose:
                tightened += 1
                if not dry:
                    tighten(dfd, base)
            continue
        added += 1
        if not dry:
            publish(dfd, base, data)
    return added, same, tightened


def open_target(target):
    # Refuse a symlinked destination: this path comes from user settings and is
    # written to, so a link planted here would redirect the whole extraction.
    if os.path.islink(target):
        die(f"profile directory is a symlink: {target}")
    os.makedirs(target, exist_ok=True)
    try:
        return os.open(target, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as e:
        die(f"cannot open profile directory {target}: {e.strerror}")


def main():
    ap = argparse.ArgumentParser(description="Fill the profile directory from FastestVPN's bundle.")
    ap.add_argument("--dir", default=default_dir(), help="profile directory")
    ap.add_argument("--dry-run", action="store_true", help="report what would change")
    args = ap.parse_args()
    if not args.dir:
        die("empty profile directory")
    if os.geteuid() == 0:
        die("do not run this as root; it is meant to run as your own user")

    dfd = open_target(args.dir)
    print("downloading bundle…", flush=True)
    added, same, tightened = extract(download(), dfd, args.dry_run)

    if args.dry_run:
        print(f"would add or update {added} profile(s); {same} already current")
        if tightened:
            print(f"would tighten {tightened} existing profile(s) to 0644")
        print("(dry run — nothing changed)")
        return
    count = sum(1 for e in os.scandir(dfd)
                if e.name.endswith(".ovpn") and e.is_file(follow_symlinks=False))
    print(f"added or updated {added} profile(s); {same} already current")
    if tightened:
        print(f"tightened {tightened} existing profile(s) to 0644")
    print(f"profile directory: {args.dir} ({count} profiles)")


if __name__ == "__main__":
    main()
